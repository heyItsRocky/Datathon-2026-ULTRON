# ULTRON Frontend Environment Configuration

# Set to "false" to connect to the live backend (local API or Catalyst)
# Set to "true" to use mock data for development
VITE_MOCK_MODE=false

# API base URL
# Local fallback:  http://127.0.0.1:8787
# After Catalyst deploy: https://{project_id}-{deployment_id}.cs.{region}.catalyst.zoho.com
VITE_API_BASE_URL=http://127.0.0.1:8787

# Catalyst Client ID (for Catalyst Authentication embedded login)
# Find this in Catalyst Console → App → Authentication → Client ID
VITE_CATALYST_CLIENT_ID=
