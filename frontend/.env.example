# ULTRON Frontend Environment Configuration

# Set to "false" to connect to the live Catalyst backend
# Set to "true" (default) to use mock data for development
VITE_MOCK_MODE=true

# Catalyst Function URL (only needed when VITE_MOCK_MODE=false)
# Deploy the unified API function first, then paste its URL here.
VITE_API_BASE_URL=

# Catalyst Client ID (for Catalyst Authentication embedded login)
# Find this in Catalyst Console → App → Authentication → Client ID
VITE_CATALYST_CLIENT_ID=
